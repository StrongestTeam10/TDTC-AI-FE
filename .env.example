# 이 파일은 "어떤 환경변수가 필요한지"만 알려주는 템플릿입니다.
# 실제 값이 담긴 .env.development / .env.production 은 .gitignore 대상이며
# 절대 커밋하지 않습니다 (이 저장소는 공개입니다).
#
# ─────────────────────────────────────────────────────────────
# 로컬 개발
#   .env.development 을 만들어 아래 값을 채웁니다.
#
# 운영 배포
#   파일을 만들지 않습니다. CodeBuild 프로젝트 설정의 "환경 변수"에 등록하세요.
#   (CodePipeline > FE-ST10-github > Build 단계의 CodeBuild 프로젝트 > 환경 편집)
#   Vite는 셸 환경변수를 .env 파일보다 우선 적용합니다.
# ─────────────────────────────────────────────────────────────

# Java BE API 주소. 반드시 끝에 /api 가 붙어야 합니다.
#   로컬: http://localhost:8080/api
#   운영: http://3.34.243.247/api   (CloudFront 적용 후 해당 도메인으로 교체)
VITE_API_BASE_URL=

# Kakao 지도 JavaScript 키.
# 브라우저에 노출되는 성격의 키이므로 Kakao 개발자 콘솔에서
# 반드시 "플랫폼 > Web > 사이트 도메인" 제한을 걸어두세요.
VITE_KAKAO_JS_KEY=

# CCTV AI 파이프라인(FastAPI). AWS가 아니라 로컬 GPU에서 돌고 ngrok으로 노출됩니다.
# 로컬 서버가 켜져 있을 때만 응답합니다.
#   로컬: http://localhost:8088  /  ws://localhost:8088/ws/cctv-stream
#   운영: https://<ngrok-domain> /  wss://<ngrok-domain>/ws/cctv-stream
#
# HTTPS 페이지에서는 ws:// 가 브라우저에 차단되므로 운영은 반드시 wss:// 여야 합니다.
VITE_CCTV_API_BASE_URL=
VITE_CCTV_WS_URL=
